{
  "name": "dsh-unsandboxed-winbash",
  "version": "0.1.5",
  "description": "Windows 上给 dsh 增加 Git Bash（MSYS2）工具的插件：Git Bash 无法在文件沙箱内启动（MSYS 运行时需要的命名管道被受限 token 拒绝），所以本插件在沙箱之外执行它，并在工具描述里写明这一点；pwsh、权限预设与 fs 工具的沙箱保持不变。Adds a Git Bash (MSYS2) tool to dsh on Windows: Git Bash cannot start inside the harness file sandbox (its MSYS runtime needs a named pipe the restricted token refuses), so this tool spawns it outside the sandbox and says so in its own description, while pwsh, the permission presets and the fs tools keep their sandbox unchanged.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./tool": "./lib/tool/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.5-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.5-0 || ^0.1.6-0 || ^0.1.7-0",
    "@deepseek-ai/dsh-shell": "^0.1.5-0 || ^0.1.6-0 || ^0.1.7-0",
    "@deepseek-ai/dsh-subprocess": "^0.1.5-0 || ^0.1.6-0 || ^0.1.7-0",
    "@deepseek-ai/dsh-timeout": "^0.1.5-0 || ^0.1.6-0 || ^0.1.7-0",
    "@deepseek-ai/dsh-tools": "^0.1.5-0 || ^0.1.6-0 || ^0.1.7-0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.5-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node scripts/run-layer.mjs test/unit",
    "test:e2e": "node scripts/run-layer.mjs test/e2e --test-force-exit",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "dsh-plugin",
    "winbash",
    "git-bash",
    "msys2",
    "windows"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "xswt442-cmd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xswt442-cmd/dsh-unsandboxed-winbash.git"
  },
  "homepage": "https://github.com/xswt442-cmd/dsh-unsandboxed-winbash#readme",
  "bugs": {
    "url": "https://github.com/xswt442-cmd/dsh-unsandboxed-winbash/issues"
  }
}
